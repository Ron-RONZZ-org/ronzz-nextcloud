+	// [PATCH ronzz.org] ---- external secondary accounts -------------------------
+	// Policy: @ronzz.org restriction applies to primary login only. Secondary
+	// accounts may use any personal/external domain; server settings are either
+	// detected via Thunderbird-style autoconfig or entered manually.
+
+	/**
+	 * HTTP GET with a short timeout. Discovery runs inside the interactive
+	 * login/add-account flow, so a hung upstream must not stall it (PHP's
+	 * default_socket_timeout is 60s).
+	 */
+	private static function httpGet(string $sUrl) : ?string
+	{
+		$rCtx = \stream_context_create([
+			'http' => ['timeout' => 5, 'follow_location' => 1, 'ignore_errors' => 1],
+			'https' => ['timeout' => 5, 'follow_location' => 1, 'ignore_errors' => 1]
+		]);
+		$sData = @\file_get_contents($sUrl, false, $rCtx);
+		return \is_string($sData) ? $sData : null;
+	}
+
+	/**
+	 * Map an autoconfig socketType / port pair to a ConnectionSecurityType
+	 * constant (0 = none, 1 = SSL, 2 = STARTTLS).
+	 */
+	private static function securityType($mType, int $iPort) : int
+	{
+		if (\is_int($mType) || \ctype_digit((string) $mType)) {
+			return (int) $mType;
+		}
+		switch (\strtoupper((string) $mType)) {
+			case 'SSL':
+			case 'TLS':
+			case 'IMAPS':
+				return ConnectionSecurityType::SSL;
+			case 'STARTTLS':
+				return ConnectionSecurityType::STARTTLS;
+		}
+		if (993 === $iPort || 995 === $iPort || 465 === $iPort) {
+			return ConnectionSecurityType::SSL;
+		}
+		if (587 === $iPort || 143 === $iPort) {
+			return ConnectionSecurityType::STARTTLS;
+		}
+		return ConnectionSecurityType::NONE;
+	}
+
+	/**
+	 * Hostnames from autoconfig XML must be concrete: reject template
+	 * placeholders (e.g. "%IMAPSERVERNAME%"), IP literals and localhost
+	 * (SSRF hygiene).
+	 */
+	private static function isUsableHostname(string $sHost) : bool
+	{
+		$sHost = \trim($sHost);
+		if (!\strlen($sHost) || \str_contains($sHost, '%')) {
+			return false;
+		}
+		if (\filter_var($sHost, \FILTER_VALIDATE_IP) || \str_contains($sHost, 'localhost')) {
+			return false;
+		}
+		return true;
+	}
+
+	/**
+	 * Build a synthetic Domain from explicit server settings (manual mode).
+	 * SMTP falls back to the IMAP host when not given. Returns null when no
+	 * usable IMAP host is present.
+	 */
+	public static function manualDomain(string $sEmail, array $aManual) : ?\RainLoop\Model\Domain
+	{
+		$sDomainName = \strtolower(\idn_to_ascii(\MailSo\Base\Utils::getEmailAddressDomain($sEmail)));
+		$aImap = $aManual['imap'] ?? [];
+		$aSmtp = $aManual['smtp'] ?? [];
+		$sImapHost = \trim((string) ($aImap['host'] ?? ''));
+		$sSmtpHost = \trim((string) ($aSmtp['host'] ?? '')) ?: $sImapHost;
+		if (!\strlen($sImapHost)) {
+			return null;
+		}
+		$aDomain = [
+			'IMAP' => [
+				'host' => $sImapHost,
+				'port' => (int) ($aImap['port'] ?? 993) ?: 993,
+				'type' => static::securityType($aImap['type'] ?? null, (int) ($aImap['port'] ?? 993)),
+				'timeout' => 300,
+				'shortLogin' => !empty($aImap['shortLogin']),
+				'lowerLogin' => false,
+				'stripLogin' => ''
+			],
+			'SMTP' => [
+				'host' => $sSmtpHost,
+				'port' => (int) ($aSmtp['port'] ?? 587) ?: 587,
+				'type' => static::securityType($aSmtp['type'] ?? null, (int) ($aSmtp['port'] ?? 587)),
+				'timeout' => 60,
+				'shortLogin' => !empty($aSmtp['shortLogin']),
+				'lowerLogin' => false,
+				'stripLogin' => '',
+				'useAuth' => true,
+				'setSender' => false,
+				'usePhpMail' => false,
+				'authPlainLine' => false
+			],
+			'Sieve' => [
+				'enabled' => false,
+				'host' => '',
+				'port' => 4190,
+				'type' => 0,
+				'timeout' => 10,
+				'shortLogin' => false,
+				'lowerLogin' => false
+			],
+			'whiteList' => ''
+		];
+		return \RainLoop\Model\Domain::fromArray($sDomainName, $aDomain);
+	}
+
+	/**
+	 * Discover server settings for an arbitrary domain (Thunderbird-style
+	 * autoconfig) and return them as a synthetic Domain, or null when nothing
+	 * usable was found (unreachable, placeholder hostnames, no IMAP entry...).
+	 */
+	public static function discoverDomain(string $sEmail) : ?\RainLoop\Model\Domain
+	{
+		$aConfig = static::discover($sEmail);
+		if (!$aConfig) {
+			return null;
+		}
+		$aIncoming = $aConfig['incomingServer'] ?? [];
+		$aOutgoing = $aConfig['outgoingServer'] ?? [];
+		if (isset($aIncoming['@attributes'])) {
+			$aIncoming = [$aIncoming];
+		}
+		if (isset($aOutgoing['@attributes'])) {
+			$aOutgoing = [$aOutgoing];
+		}
+		$aImap = $aSmtp = null;
+		foreach ($aIncoming as $aServer) {
+			if ('imap' === ($aServer['@attributes']['type'] ?? '')
+			 && static::isUsableHostname($aServer['hostname'] ?? '')) {
+				$aImap = $aServer;
+				break;
+			}
+		}
+		foreach ($aOutgoing as $aServer) {
+			if ('smtp' === ($aServer['@attributes']['type'] ?? '')
+			 && static::isUsableHostname($aServer['hostname'] ?? '')) {
+				$aSmtp = $aServer;
+				break;
+			}
+		}
+		if (!$aImap) {
+			return null;
+		}
+		$sUsername = (string) ($aImap['username'] ?? '%EMAILADDRESS%');
+		return static::manualDomain($sEmail, [
+			'imap' => [
+				'host' => $aImap['hostname'],
+				'port' => (int) ($aImap['port'] ?? 993) ?: 993,
+				'type' => static::securityType($aImap['socketType'] ?? null, (int) ($aImap['port'] ?? 993)),
+				'shortLogin' => '%EMAILLOCALPART%' === $sUsername
+			],
+			'smtp' => [
+				'host' => $aSmtp ? $aSmtp['hostname'] : '',
+				'port' => (int) ($aSmtp['port'] ?? 587) ?: 587,
+				'type' => static::securityType($aSmtp['socketType'] ?? null, (int) ($aSmtp['port'] ?? 587))
+			]
+		]);
+	}
+
 }
