+	// [PATCH ronzz.org] external secondary accounts: include the resolved
+	// server settings in jsonSerialize() output. The account-switch cookie
+	// (AUTH_ADDITIONAL_TOKEN_KEY) is built from jsonSerialize() via
+	// Cookies::setSecure(); the post-switch reload restores the account from
+	// that cookie. Without 'manual', an external domain (no config file)
+	// would have to be re-resolved via autoconfig - broken for some
+	// providers (e.g. univ-lorraine.fr) - and the app would fall back to
+	// the main account view.
+	#[\ReturnTypeWillChange]
+	public function jsonSerialize()
+	{
+		$aResult = parent::jsonSerialize();
+		if ($this->ManualSettings()) {
+			$aResult['manual'] = $this->ManualSettings();
+		}
+		return $aResult;
+	}
