[Unit]
Description=mailwatch — IMAP IDLE spam/idler daemon for Migadu
Documentation=https://github.com/Ron-RONZZ-org/ronzz-nextcloud/blob/main/mailwatch/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailwatch
Group=mailwatch
# Explicit data/config dirs (the daemon's HOME-based defaults would place
# the DB under ~/.local/share/mailwatch/; keep state at /var/lib/mailwatch).
Environment=MAILWATCH_DATA_DIR=/var/lib/mailwatch
Environment=MAILWATCH_CONFIG_DIR=/etc/mailwatch
ExecStart=/opt/mailwatch/venv/bin/mailwatch run --config /etc/mailwatch/config.toml
Restart=on-failure
RestartSec=10
# Standard output goes to the journal; audit trail is written separately.
StandardOutput=journal
StandardError=journal
# Hardening (outbound-only daemon: no exposed ports).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mailwatch /var/log/mailwatch
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
