# Mailwatch alert delivery.  The alert script (/usr/local/sbin/mailwatch-alert)
# ALWAYS writes /var/log/mailwatch/alerts.log and the journal.  Setting
# ALERT_WEBHOOK_URL additionally pushes a short notice (no mail content).
#
# Copy to /etc/mailwatch/alert.env (mode 0600) and set one channel, e.g.:
#   ntfy (hosted, FOSS):  https://ntfy.sh/<random-topic>      # subscribe in the ntfy app / browser
#   healthchecks.io:      https://hc-ping.com/<uuid>/fail
#   self-hosted ntfy / Gotify / Slack / Discord: adjust the curl line in the script.
#
# Leave it unset/commented to disable push (the log + journal keep working).
#ALERT_WEBHOOK_URL=https://ntfy.sh/CHANGEME
