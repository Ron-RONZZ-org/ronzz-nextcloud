[Unit]
Description=Hesk OIDC-RP sidecar (threads.ronzz.org staff panel behind Nextcloud login)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hesk-oidc
Group=hesk-oidc
WorkingDirectory=/opt/hesk-oidc
EnvironmentFile=/opt/hesk-oidc/hesk-oidc.env
Environment=PATH=/opt/hesk-oidc/.venv/bin:/usr/bin
ExecStart=/opt/hesk-oidc/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8016
Restart=on-failure
RestartSec=5
# 8 h sessions are expected; keep the cookie in sync via HESK_SESSION_TTL above

[Install]
WantedBy=multi-user.target
